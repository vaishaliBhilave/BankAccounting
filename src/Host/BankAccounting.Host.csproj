<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>BankAccounting.Host</RootNamespace>
    <AssemblyName>BankAccounting.Host</AssemblyName>
    <!-- Relaxed here only because package APIs change between versions; domain projects stay strict. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating versions: run `dotnet restore` once, then pin the resolved versions. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="*" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.*" />
    <PackageReference Include="dbup-postgresql" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accounts\BankAccounting.Accounts.csproj" />
    <ProjectReference Include="..\Ledger\BankAccounting.Ledger.csproj" />
    <ProjectReference Include="..\Transactions\BankAccounting.Transactions.csproj" />
  </ItemGroup>

  <!-- SQL migrations are embedded and applied by DbUp at startup (EF Core is used for data access only). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\db\migrations\*.sql" LogicalName="migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
